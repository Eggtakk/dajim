# AI Hub Open API credentials.
# Get your key from aihub.or.kr (마이페이지 > API Key 발급) — requires an
# already-approved data download request for the target dataset.
# NEVER commit this file with a real value filled in.
AIHUB_API_KEY=

# "금융 합성 데이터" dataset id (dataSetSn) on AI Hub.
AIHUB_DATASET_KEY=71792

# Comma-separated aihubshell file keys to restrict the download to specific
# files (e.g. just 카드 승인매출정보). Leave empty to download everything
# aihubshell lists for AIHUB_DATASET_KEY.
AIHUB_FILE_KEYS=

# Where downloaded/raw CSVs land.
AIHUB_DATA_DIR=./data/raw
